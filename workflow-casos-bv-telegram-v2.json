    {
      "parameters": {
        "jsCode": "// CONFIGURA\u00c7\u00c3O\nconst DATASTORE_KEY = \"contador_casos_criticos\";\n\nconst dataStore = $getWorkflowStaticData('global');\n\nif (!dataStore[DATASTORE_KEY]) {\n  dataStore[DATASTORE_KEY] = 0;\n}\n\ndataStore[DATASTORE_KEY]++;\n\nconst contador = dataStore[DATASTORE_KEY];\n\nlet idCaso = \"CRIT-\" + String(contador).padStart(4, \"0\");\nlet protocoloBV = \"\";\n\n// ----- PEGAR DADOS DO TELEGRAM -----\n\nconst mensagem = $json.message.text;\nconst partes = mensagem.split(\"\\n\");\n\n// ----- NOVO: CAPTURAR CRIT + BV (SE EXISTIR) -----\n\nconst match = mensagem.match(/(CRIT-\\d+)\\s+BV\\s+(\\d+)/i);\n\nif (match) {\n  idCaso = match[1];          // sobrescreve se vier manual\n  protocoloBV = match[2];\n}\n\n// fun\u00e7\u00e3o para limpar prefixos\nfunction limparTexto(texto, regex) {\n  if (!texto) return \"\";\n  return texto.replace(regex, \"\").trim();\n}\n\n// limpar etiquetas\nconst protocolo = limparTexto(partes[0], /Protocolo\\s*N1\\s*:/i);\nconst cliente = limparTexto(partes[1], /C\u00f3digo\\s*Cliente\\s*:/i);\nconst assunto = limparTexto(partes[2], /Assunto\\s*Caso\\s*:/i);\nconst descricao = limparTexto(partes[3], /Detalhamento\\s*Caso\\s*:/i);\nconst motivo = limparTexto(partes[4], /Motivo\\s*Escalonamento\\s*:/i);\n\n// ----- DATA E HORA -----\n\nconst timestamp = $json.message.date;\n\nconst dataObj = new Date(timestamp * 1000);\n\nconst data = dataObj.toLocaleDateString(\"pt-BR\", { timeZone: \"America/Sao_Paulo\" });\nconst hora = dataObj.toLocaleTimeString(\"pt-BR\", { timeZone: \"America/Sao_Paulo\" });\n\n// ----- RESPONS\u00c1VEL -----\n\nconst responsavel = ($json.message.from.last_name || \"\");\n\n// ----- SA\u00cdDA -----\n\nreturn [\n{\njson: {\n\nID_Caso: idCaso,\nProtocolo_BV: protocoloBV,\n\nData_Abertura: data,\nHora_Abertura: hora,\n\nProtocolo: protocolo,\nCodigo_Cliente: cliente,\n\nAssunto: assunto,\nDescricao: descricao,\n\nResponsavel: responsavel,\n\nStatus: \"Aberto\",\n\nDias_Aberto: 0,\n\nTimestamp_Abertura: timestamp\n\n}\n}\n];"
      },
